# PocketBase server URL (docker compose up -d exposes it on 8090)
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090

# Google OAuth (optional, enables "Continue with Google").
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# with authorized redirect URI: <POCKETBASE_URL>/api/oauth2-redirect
# e.g. http://127.0.0.1:8090/api/oauth2-redirect for local dev.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Account cap (PocketBase). Sign-ups are refused once this many accounts
# exist; guest mode keeps working. Default 6000 (~120 GB at the 20 MB quota).
# 0 disables the cap.
MAX_USERS=6000

# Per-user media quota in bytes (PocketBase). Default 20 MB, or 1 GB for users
# with the premium flag. Keep in sync with src/lib/quota.ts (client display).
MAX_USER_DATA_BYTES=20971520
MAX_PREMIUM_DATA_BYTES=1073741824

# Deploy target for `just deploy` / `just pb-deploy`, as user@host or an ssh
# config alias. Maintainer-only; leave empty unless you run your own server.
DEPLOY_HOST=
