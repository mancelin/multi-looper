# PocketBase server URL (docker compose up -d exposes it on 8090)
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090

# Google OAuth (optional — enables "Continue with Google").
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# with authorized redirect URI: <POCKETBASE_URL>/api/oauth2-redirect
# e.g. http://127.0.0.1:8090/api/oauth2-redirect for local dev.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TIDAL source (optional — enables playing tidal.com track links).
# Register an app at https://developer.tidal.com/dashboard and add this app's
# origin (e.g. http://localhost:3000/) as the redirect URI. Users connect
# their own tidal.com account (subscription required for full playback).
NEXT_PUBLIC_TIDAL_CLIENT_ID=
